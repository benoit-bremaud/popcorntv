          "value": "(\"preparation_attempts\".\"state\" = 'uncertain' AND \"preparation_attempts\".\"upstream_reference\" IS NULL AND \"preparation_attempts\".\"retirement_reason\" IS NULL) OR (\"preparation_attempts\".\"state\" = 'accepted' AND \"preparation_attempts\".\"upstream_reference\" IS NOT NULL AND \"preparation_attempts\".\"retirement_reason\" IS NULL) OR (\"preparation_attempts\".\"state\" = 'retired' AND \"preparation_attempts\".\"retirement_reason\" IS NOT NULL AND ((\"preparation_attempts\".\"retirement_reason\" = 'not_accepted' AND \"preparation_attempts\".\"upstream_reference\" IS NULL) OR (\"preparation_attempts\".\"retirement_reason\" = 'finished' AND \"preparation_attempts\".\"upstream_reference\" IS NOT NULL)))"
