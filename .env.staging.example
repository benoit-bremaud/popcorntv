# Copy to .env.staging (gitignored) for `make staging-up`. Placeholders only.
# HOST, MEDIA_ROOT, PUBLIC_URL, TRUST_PROXY and the cache folders are set by
# deploy/staging/compose.yml, as on the Pi.
TMDB_API_KEY=your-tmdb-read-access-token
TMDB_LANGUAGE=fr-FR
# Keep warn or lower until the first account exists: the setup link is a warn line.
LOG_LEVEL=info
TRANSCODE_MAX_SESSIONS=1
SCAN_INTERVAL_MIN=60
