# Local staging site (#204): the homelab site block (deploy/homelab/Caddyfile) on
# https://localhost:8443 — same tls internal, headers and routes, no `tailnet_only` (loopback
# only). Keep it in step with the homelab copy.
{
	admin off
	skip_install_trust
}

localhost:8443 {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle_path /api/* {
		reverse_proxy popcorntv:3000
	}

	handle /assets/* {
		root * /srv/popcorntv-web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy matches on the decoded, cleaned path: `/api/x/..%2f..%2fetc` reaches the
	# routes below as `/etc`. The raw path still says /api, so it is an API miss (#177).
	@rawApi expression `{http.request.orig_uri.path}.startsWith("/api/") || {http.request.orig_uri.path} == "/api"`
	handle @rawApi {
		header Content-Type application/json
		respond `{"error":"not_found"}` 404
	}

	# The app has no client routes: only real files and `/` (index.html) exist. Anything
	# else is a real 404 with the static 404 page (#177), never index.html with a 200.
	handle {
		root * /srv/popcorntv-web
		header Cache-Control "no-cache"
		# A path under a file (`/index.html/x`) would be a bare 400 from file_server.
		@missing not file {path} {path}index.html
		error @missing 404
		file_server
	}

	handle_errors 404 {
		root * /srv/popcorntv-web
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
