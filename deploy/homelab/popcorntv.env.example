# Copy to popcorntv.env next to the live compose file (never committed). Placeholders only.
TMDB_API_KEY=your-tmdb-read-access-token
TMDB_LANGUAGE=fr-FR
LOG_LEVEL=info
TRANSCODE_MAX_SESSIONS=1
SCAN_INTERVAL_MIN=60
# Minutes between wishlist availability checks (in-app notifications, ADR-0030); 0 disables,
# at most 35791 (same bounds as SCAN_INTERVAL_MIN).
WISHLIST_CHECK_INTERVAL_MIN=60
