# Copy to .env.local (gitignored). Placeholders only — never commit a real value.

# Server
PORT=3000
# Loopback by default; 0.0.0.0 only behind a reverse proxy or in Docker.
HOST=127.0.0.1
# Required: the one origin every browser uses (cookie flags, CSRF check, links).
# Dev: the Vite origin. Production: the HTTPS origin served by the reverse proxy.
PUBLIC_URL=http://localhost:5173
# Behind a reverse proxy only: its fixed address (e.g. 172.18.0.10), comma-separated for
# several; a CIDR only for a network holding the proxy and the app alone. Only those peers
# may set the client IP through X-Forwarded-For.
TRUST_PROXY=
LOG_LEVEL=info

# Storage
DATABASE_PATH=data/popcorntv.sqlite
# Every library root must be this folder or live under it.
MEDIA_ROOT=media
# HLS session folders (one per playing title); leftover session-* folders are removed at start.
TRANSCODE_DIR=data/transcode
# Transcodes allowed at once; one more gets 503 transcode_busy.
TRANSCODE_MAX_SESSIONS=1

# Metadata provider — the free "API Read Access Token" (long eyJ… token) from
# https://www.themoviedb.org/settings/api; the short v3 key is NOT accepted (it only works
# as a query parameter). Leave the placeholder to run without metadata enrichment.
TMDB_API_KEY=your-tmdb-read-access-token
# Language of titles and synopses (TMDB `language` parameter).
TMDB_LANGUAGE=en-US
# Cached posters / backdrops, served by GET /artwork/:file.
ARTWORK_DIR=data/artwork

# Path to the FFmpeg binaries (defaults to the ones on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Web dev server (Vite) — read from the shell: the /api proxy target.
API_URL=http://localhost:3000
